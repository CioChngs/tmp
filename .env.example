# Copy to .env and fill in for your environment:
#   cp .env.example .env
#
# EXPO_PUBLIC_* variables are INLINED INTO THE JS BUNDLE — anyone with the app
# can read them. Never put an API key, token, or password here. A value that
# must stay secret cannot live in a mobile client at all; put it behind the
# gateway instead.
#
# The EXPO_PUBLIC_ prefix is required: Metro only inlines variables that carry
# it. A bare APIM_TOKEN_URL reads back as undefined at runtime.
#
# Restart the dev server after editing (Metro caches the inlined values):
#   npx expo start --clear
#
# Per-developer overrides go in .env.local.

# APIM token endpoint host — login, refresh and revoke.
EXPO_PUBLIC_APIM_TOKEN_URL=https://apim.example.mn

# APIM gateway host. Service base URLs are <gateway>/<context>/<version>.
EXPO_PUBLIC_APIM_GATEWAY_URL=https://apigw.example.mn

# Published context and version of the banner API.
EXPO_PUBLIC_APIM_BANNER_CONTEXT=BANNER_CONTENT
EXPO_PUBLIC_APIM_BANNER_VERSION=1.0
